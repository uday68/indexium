# Indexium Environment Configuration
PROJECT_NAME=Indexium
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Default Ranker: bm25, tfidf, pagerank
DEFAULT_RANKER=bm25

# Database URL (defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./indexium.db
# DATABASE_URL=postgresql://indexium:indexium123@localhost:5432/indexium_db

# Redis Cache URL (optional, falls back to LRU cache if omitted)
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Crawler Politeness & Bounds
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=50
CRAWLER_POLITENESS_DELAY=0.2
CRAWLER_USER_AGENT=IndexiumCrawler/1.0
